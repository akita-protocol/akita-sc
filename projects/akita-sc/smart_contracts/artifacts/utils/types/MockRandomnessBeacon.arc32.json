    "schema": {
        "global": {
            "declared": {
                "empty": {
                    "type": "uint64",
                    "key": "empty",
                    "descr": "when true, `get` returns empty bytes (beacon value unavailable)"
                },
                "seed": {
                    "type": "bytes",
                    "key": "seed",
                    "descr": "override seed; empty means \"use the default seed\""
                },
                "submitLag": {
                    "type": "uint64",
                    "key": "submitLag",
                    "descr": "0 = every round is available at once. Otherwise mirrors MainNet beacon 1615566206: it stores\none value per multiple of 8, answers round r from ceil8(r), and that value lands `submitLag`\nrounds after ceil8(r)"
                }
            },
            "reserved": {}
        },
        "local": {
            "declared": {},
            "reserved": {}
        }
    },
    "contract": {
        "name": "MockRandomnessBeacon",
        "desc": "Mock VRF beacon for testing purposes (test-only, never deployed to a live network).\n\nBy default it returns a fixed 32-byte seed for every round. Tests can override\nthe seed (`setSeed`) to steer the drawn ticket, make every read come back\nempty (`setEmpty`) to exercise the beacon-failure path, or model the MainNet\nbeacon's timing (`setSubmitLag`).",
        "methods": [
            {
                "name": "get",
                "args": [
                    {
                        "type": "uint64",
                        "name": "round"
                    },
                    {
                        "type": "byte[]",
                        "name": "userData"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "byte[]"
                },
                "desc": "Returns mock random bytes for testing."
            },
            {
                "name": "setSeed",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "seed"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "test helper: use `seed` for every subsequent read (empty bytes restores the default)"
            },
            {
                "name": "setEmpty",
                "args": [
                    {
                        "type": "bool",
                        "name": "empty"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "test helper: make every subsequent read return empty bytes"
            },
            {
                "name": "setSubmitLag",
                "args": [
                    {
                        "type": "uint64",
                        "name": "lag"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "test helper: model the MainNet beacon's ceil-to-8 storage and submission lag (0 disables)"
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "no_op": "CREATE"
    }
}