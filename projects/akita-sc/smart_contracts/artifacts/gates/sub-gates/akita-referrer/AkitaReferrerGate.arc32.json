    "contract": {
        "name": "AkitaReferrerGate",
        "desc": "Passes when the acting Akita wallet's `referrer` is the registered referrer. The referrer is\nself-asserted (residual R-REFERRER): it was chosen at wallet creation and an admin-updated\nwallet can rewrite it.\n\nContext-aware (principal-resolution spec \u00a76.9): `checkFor(ctx, ...)` uses `ctx.wallet`, the\nwallet the first hop verified for this action. No registry read, so it also works for wallets\nwith an external controlled address and for wallets that never registered. Args are ignored.\nThe plain `check(caller, ...)` keeps the legacy registry rule (args = the 8-byte wallet id\nregistered for `caller`) but returns false instead of reverting when `caller` is unregistered.",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "string",
                        "name": "version"
                    },
                    {
                        "type": "uint64",
                        "name": "akitaDAO"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "cost",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
                "name": "register",
                "args": [
                    {
                        "type": "pay",
                        "name": "mbrPayment"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
                "name": "check",
                "args": [
                    {
                        "type": "address",
                        "name": "caller"
                    },
                    {
                        "type": "uint64",
                        "name": "registryID"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "bool"
                },
                "desc": "LEGACY subject rule (EscrowFactory registry): `args` is the 8-byte wallet id registered for\n`caller`. Returns false (no revert) when `caller` is not registered or is registered to\nanother wallet, so OR groups keep working."
            },
            {
                "name": "checkFor",
                "args": [
                    {
                        "type": "(address,uint64,address)",
                        "name": "ctx"
                    },
                    {
                        "type": "uint64",
                        "name": "registryID"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "bool"
                },
                "desc": "Context-aware check: rule `ctx.wallet != 0 && referrer(ctx.wallet) == registered`. `ctx.wallet`\nis the actor's own wallet, verified by the first hop (spec \u00a73.5), so no one can borrow another\nwallet's referrer. `args` are ignored (any value, including the legacy 8-byte wallet id).\nResource: P(ctx.wallet)."
            },
            {
                "name": "getEntry",
                "args": [
                    {
                        "type": "uint64",
                        "name": "registryID"
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "byte[]"
                }
            },
            {
                "name": "updateAkitaDAO",
                "args": [
                    {
                        "type": "uint64",
                        "name": "akitaDAO"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "opUp",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            }
        ],
        "networks": {}
    },
    "bare_call_config": {}
