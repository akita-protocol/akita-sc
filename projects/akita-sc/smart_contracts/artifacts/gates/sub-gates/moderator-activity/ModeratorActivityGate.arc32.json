    "contract": {
        "name": "ModeratorActivityGate",
        "desc": "Passes when the subject is a moderator with at least `minActions` counted moderation actions in\nthe current epoch (7 days), plus the previous epoch when `epochsBack` is 1. Counts come from\n`AkitaSocialModeration.moderatorActivity`, a net count: forward actions add one, reversals take one off.\n\nContext-aware (principal-resolution spec \u00a76.9): `checkFor(ctx, ...)` passes when either the verified\nprincipal or the spender qualifies. Moderation records actions under the sender of the moderation\ncall, which is the spender when a moderator acts through a wallet escrow window.",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "string",
                        "name": "version"
                    },
                    {
                        "type": "uint64",
                        "name": "akitaDAO"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "cost",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
                "name": "register",
                "args": [
                    {
                        "type": "pay",
                        "name": "mbrPayment"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
                "name": "check",
                "args": [
                    {
                        "type": "address",
                        "name": "caller"
                    },
                    {
                        "type": "uint64",
                        "name": "registryID"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "bool"
                }
            },
            {
                "name": "checkFor",
                "args": [
                    {
                        "type": "(address,uint64,address)",
                        "name": "ctx"
                    },
                    {
                        "type": "uint64",
                        "name": "registryID"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "bool"
                },
                "desc": "Context-aware check (see the class comment). No args."
            },
            {
                "name": "getRegistrationShape",
                "args": [
                    {
                        "type": "(uint64,uint64)",
                        "name": "shape"
                    }
                ],
                "readonly": true,
                "returns": {
