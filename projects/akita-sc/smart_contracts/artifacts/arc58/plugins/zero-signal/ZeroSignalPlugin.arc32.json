    "contract": {
        "name": "ZeroSignalPlugin",
        "desc": "A pay plugin that can only pay the ZeroSignal escrow app.\n\nIt keeps PayPlugin's `pay` signature and refuses any receiver other than\nthe escrow app's own address. The escrow app id is written once at creation\nand has no setter, and the program has no update or delete route, so the\ntarget can never change.",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "uint64",
                        "name": "escrowApp"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "pay",
                "args": [
                    {
                        "type": "uint64",
                        "name": "wallet"
                    },
                    {
                        "type": "bool",
                        "name": "rekeyBack"
                    },
                    {
                        "type": "(address,uint64,uint64)[]",
                        "name": "payments"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Pay ALGO or an asset from the wallet's spending account to the escrow.\nA zero amount is allowed."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {}
