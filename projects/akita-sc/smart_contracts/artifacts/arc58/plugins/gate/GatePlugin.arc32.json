    "contract": {
        "name": "GatePlugin",
        "desc": "Gate plugin v2: registers composite gates from an ARC-58 wallet.\n\nResolves the canonical Gate app from the DAO registry on every call (audit SG-16), so a\nGate redeploy only needs a DAO registry update, not a plugin redeploy. The Gate app\nitself enforces the sub-gate allowlist and per-filter cost cap, which bounds how much the\nwallet can be charged.",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "uint64",
                        "name": "akitaDAO"
                    },
                    {
                        "type": "string",
                        "name": "version"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "register",
                "args": [
                    {
                        "type": "uint64",
                        "name": "wallet"
                    },
                    {
                        "type": "bool",
