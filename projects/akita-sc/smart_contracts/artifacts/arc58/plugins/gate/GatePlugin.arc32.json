                        "type": "(uint64,uint64,uint8)[]",
                        "name": "filters"
                    },
                    {
                        "type": "byte[][]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
