    "contract": {
        "name": "MockWallet",
        "desc": "Test stand-in for an ARC-58 wallet (FINAL-SPEC WP5a, akita-hooks A12 fixture 5). It publishes a\n`controlled_address` global (the key AbstractedAccount uses) and nothing else: it has no\n`spending_address` and never calls an app, so it can never satisfy a wallet hint\n(utils/principal.ts: the direct arm needs `Global.callerApplicationId == W`, the plugin arm needs\n`W.spending_address`). A \"genuine\" MockWallet is created by MockWalletFactory (set as\n`AkitaAppList.wallet`); a \"foreign\" one is created directly by an EOA.\n\nPrincipal resolution (spec \u00a76.12) removed the EscrowFactory registration this mock used to do. Hinted\ncases run against real AbstractedAccount wallets (gated-fee.e2e.spec.ts, \"principal resolution\").\n\nThe operator can rekey the wallet account to a test EOA, which then sends transactions with\n`sender = wallet address`. The suite uses this to drive the DAO's wallet for DAO-only methods.",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "address",
                        "name": "controlledAddress"
                    },
                    {
                        "type": "address",
                        "name": "admin"
                    },
                    {
                        "type": "address",
                        "name": "operator"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "rekeyTo",
                "args": [
                    {
                        "type": "address",
                        "name": "to"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Operator only: rekey the wallet account so a test EOA can sign as it"
            }
        ],
        "networks": {}
    },
    "bare_call_config": {}
}