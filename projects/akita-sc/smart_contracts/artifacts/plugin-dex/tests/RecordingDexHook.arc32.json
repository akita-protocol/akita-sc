    "contract": {
        "name": "RecordingDexHook",
        "desc": "Test-only hook (FINAL-SPEC \u00a72.2, \u00a74.12 tests 2 and 9) that records, per hook point, the last\nHookContext it received (caller, callerApp, recipient, data, ...) and its own balance at that\nmoment, so tests can check F6 funding/initData and the quote identity rules. It rejects the\ninitData 'reject' at AfterInitialize, and hands custody straight back when it is a custody hook.\nBox MBR for the records comes from its F6 funding (or a direct top-up).",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "uint64",
                        "name": "dex"
                    }
                ],
                "readonly": false,
