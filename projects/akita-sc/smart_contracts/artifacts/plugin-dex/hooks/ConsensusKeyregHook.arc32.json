    "contract": {
        "name": "ConsensusKeyregHook",
        "desc": "ConsensusKeyregHook (FINAL-SPEC \u00a74.14): a Poke-only custody hook that registers a pool escrow for\nconsensus participation, so the escrow's reserves earn block proposer payouts for the LPs.\n\nInstall with points = Poke, perms = Custody, flags = LazyCustody. The admin (the DAO wallet) sets each\npool's participation keys and operator; the operator pokes the pool with `data = [1]` to go online\nor `data = [0]` to go offline.\n\n- Lazy custody: only an operator poke with a valid action returns RequestCustody. Every other call\n  (non-operator, a pool with no keys, another hook point) is a no-op, and the escrow is never rekeyed.\n  When installed eagerly, those calls hand custody straight back.\n- Going online pays the incentive keyreg fee (`Global.payoutsGoOnlineFee`, 2 ALGO) from the escrow when\n  payouts are enabled and the escrow is not yet incentive-eligible. The hook pre-donates exactly that\n  fee from its own balance (the \"fee tank\") in the same custody call, so the Vault's custody guard sees\n  a net ALGO delta of 0. Going offline costs the escrow nothing (fee 0).\n- Consensus rewards later arrive in the escrow as surplus and are booked into reserves by `sync`.\n\nThe tank is this app's ALGO balance (F6 funding, direct payments). It also carries the MBR of the\nper-pool key boxes. The admin can withdraw the excess.",
        "methods": [
            {
                "name": "create",
                "args": [
                    {
                        "type": "uint64",
                        "name": "dex"
                    },
                    {
                        "type": "address",
                        "name": "admin"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "setAdmin",
                "args": [
                    {
                        "type": "address",
                        "name": "admin"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "setPoolKeys",
                "args": [
                    {
                        "type": "uint64",
                        "name": "poolId"
                    },
                    {
                        "type": "(address,byte[32],byte[32],byte[64],uint64,uint64,uint64)",
                        "name": "keys"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "set (or rotate) a pool's operator and participation keys; the box MBR comes from the tank"
            },
            {
                "name": "deletePoolKeys",
                "args": [
                    {
                        "type": "uint64",
                        "name": "poolId"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "stop managing a pool: no operator can switch it any more (the escrow keeps its current status)"
            },
            {
                "name": "withdraw",
                "args": [
                    {
                        "type": "uint64",
                        "name": "amount"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "send `amount` \u00b5ALGO of the tank to the admin"
            },
            {
                "name": "getPoolKeys",
                "args": [
                    {
                        "type": "uint64",
                        "name": "poolId"
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "(address,byte[32],byte[32],byte[64],uint64,uint64,uint64)"
                }
            },
            {
                "name": "akitaDexHook",
                "args": [
                    {
                        "type": "uint64",
                        "name": "dex"
                    },
                    {
                        "type": "uint64",
                        "name": "hookIndex"
                    },
                    {
                        "type": "(uint64,uint64,uint64,address,address,uint64,uint64,address,uint64,uint64,bool,bool,uint64,uint64,uint64,uint64,uint64,uint64,uint64,uint64,uint64,(byte[16],uint64,uint64,uint64),(byte[16],uint64,uint64,uint64),byte[],byte[])",
                        "name": "ctx"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint64,uint64,uint64,uint64)"
                }
            }
        ],
        "networks": {}
    },
    "bare_call_config": {}
