    "contract": {
        "name": "MockEchoSubGate",
        "desc": "TEST-ONLY sub-gate that echoes what the Gate forwards (principal-resolution spec \u00a76.9, Q12).\nIt passes only when the filter's check args equal what it received:\n- `check(caller, id, args)`: `args == caller` (32 bytes); logs `check`.\n- `checkFor(ctx, id, args)`: `args == encodeArc4(ctx)` (72 bytes); logs `checkFor`.\nSo a test proves which call (and which subject) each filter got.",
        "methods": [
            {
                "name": "cost",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
                "name": "register",
                "args": [
                    {
                        "type": "pay",
                        "name": "mbrPayment"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64"
                }
            },
            {
                "name": "check",
                "args": [
                    {
                        "type": "address",
                        "name": "caller"
                    },
                    {
                        "type": "uint64",
                        "name": "registryID"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "bool"
                }
            },
            {
                "name": "checkFor",
                "args": [
                    {
                        "type": "(address,uint64,address)",
                        "name": "ctx"
                    },
                    {
                        "type": "uint64",
                        "name": "registryID"
                    },
                    {
                        "type": "byte[]",
                        "name": "args"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "bool"
                }
            },
            {
                "name": "getEntry",
