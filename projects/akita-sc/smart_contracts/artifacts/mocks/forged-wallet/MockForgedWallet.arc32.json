    "contract": {
        "name": "MockForgedWallet",
        "desc": "TEST-ONLY. A program installed INTO a genuine, factory-created ARC-58 wallet by its admin\n(`UpdateApplication` through the wallet's `update(string)`), for the forged-wallet cases\nT18\u2013T22, T34, T35, T40, T41, T42 and T45\u2013T47. The app keeps the factory as creator, so it passes\n`isGenuineWallet`, but every global is now attacker-chosen. AVM 13, like the wallet (no program\nversion downgrade on update). No access control on purpose. Never deploy outside tests.",
        "methods": [
            {
                "name": "update",
                "args": [
                    {
                        "type": "string",
                        "name": "version"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "opUp",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Extra resource slots for grouped calls."
            },
            {
                "name": "destroy",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "A forger can also make a once-genuine wallet id disappear (stored pairs then name a deleted app)."
            },
            {
                "name": "setBytes",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "key"
                    },
                    {
                        "type": "byte[]",
                        "name": "value"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "setUint",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "key"
                    },
                    {
                        "type": "uint64",
                        "name": "value"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Type confusion: store a uint64 under a key consumers read as bytes (T35/T46)."
            },
            {
                "name": "del",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "key"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "setAkitaDAO",
                "args": [
                    {
                        "type": "uint64",
                        "name": "dao"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "callProbeAs",
                "args": [
                    {
                        "type": "uint64",
                        "name": "probe"
                    },
                    {
                        "type": "uint64",
                        "name": "hint"
                    },
                    {
                        "type": "address",
                        "name": "sender"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint64,address,address,address,address,bool)"
                },
                "desc": "Direct-arm call: `probe.probe(hint)` sent as `sender` (this app's address, or an account rekeyed to it)."
            },
            {
                "name": "callTryProbeAs",
                "args": [
                    {
                        "type": "uint64",
                        "name": "probe"
                    },
                    {
                        "type": "uint64",
                        "name": "hint"
                    },
                    {
                        "type": "address",
                        "name": "sender"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint64,address,address,address,address,bool)"
                },
                "desc": "Direct-arm call of the non-reverting `probe.tryProbe(hint)` (T35)."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "no_op": "CREATE"
    }
}