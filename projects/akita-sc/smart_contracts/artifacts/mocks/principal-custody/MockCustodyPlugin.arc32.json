    "contract": {
        "name": "MockCustodyPlugin",
        "desc": "TEST-ONLY. A plugin with STANDING custody of an account `H` (like the router's leg escrow),\nfor E25/T42. `act` is compliant with \u00a73.8 rule 3(a): it never sends as a wallet's spending\naccount when that account is `H`. `actUnsafe` omits the guard (negative control).\nNever deploy outside tests.",
        "methods": [
            {
                "name": "init",
                "args": [
                    {
                        "type": "address",
                        "name": "held"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Record `held`, which must already be rekeyed to this app."
            },
            {
                "name": "act",
                "args": [
                    {
                        "type": "uint64",
                        "name": "wallet"
                    },
                    {
                        "type": "uint64",
                        "name": "probe"
                    },
                    {
                        "type": "uint64",
                        "name": "hint"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint64,address,address,address,address,bool)"
                },
                "desc": "Compliant: refuses to act as its standing-custody account. Rekeys the spender back to the wallet."
            },
            {
                "name": "actUnsafe",
                "args": [
                    {
                        "type": "uint64",
                        "name": "wallet"
                    },
                    {
                        "type": "uint64",
                        "name": "probe"
                    },
                    {
                        "type": "uint64",
                        "name": "hint"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "(uint64,address,address,address,address,bool)"
                },
                "desc": "NON-COMPLIANT negative control: sends as whatever `wallet.spending_address` names."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "no_op": "CREATE"
    }
}